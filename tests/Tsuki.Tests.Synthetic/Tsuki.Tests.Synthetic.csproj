<Project Sdk="Microsoft.NET.Sdk">
  <!-- No game data, no GPU: runs anywhere on every change (ARCHITECTURE 10.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tsuki.Data\Tsuki.Data.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Engine\Tsuki.Engine.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Media\Tsuki.Media.csproj" />
    <ProjectReference Include="..\..\src\Tsuki.Ui\Tsuki.Ui.csproj" />
    <!-- Package K6: the app's services, runtime and input mapping are tested without a window (ProjectRulesTests: tests may reference Tsuki.App). -->
    <ProjectReference Include="..\..\src\Tsuki.App\Tsuki.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Package K17: the launcher's logic (src/Tsuki.Launcher/Core, no WPF types) is compiled into the tests. A net10.0 test project cannot reference the net10.0-windows launcher project, and
      the one settings reader / writer both programs use comes from the Tsuki.App reference above.
    -->
    <Compile Include="..\..\src\Tsuki.Launcher\Core\*.cs" Exclude="..\..\src\Tsuki.Launcher\Core\ReleaseCheck.Shared.cs" Link="Launcher\Core\%(Filename)%(Extension)" />
    <!-- v0.1.9: the state behind the Windows launcher's Achievements page (rows, tabs, counts, when to read again) holds no WPF type either, so it is tested here the same way. -->
    <Compile Include="..\..\src\Tsuki.Launcher\AchievementsState.cs" Link="Launcher\Windows\AchievementsState.cs" />
    <!-- v0.1.9, the icons: which picture a row of that page shows and the making of the icons, likewise without a WPF type (the bitmap is a type parameter). -->
    <Compile Include="..\..\src\Tsuki.Launcher\AchievementPictures.cs" Link="Launcher\Windows\AchievementPictures.cs" />
    <!-- v0.1.9: when the Windows launcher's settings pages follow settings.ini and save.dat changed by the game, and what they show then; no WPF type either. -->
    <Compile Include="..\..\src\Tsuki.Launcher\ProfileWatch.cs" Link="Launcher\Windows\ProfileWatch.cs" />
  </ItemGroup>
</Project>
